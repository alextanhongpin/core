	<section>
		<br><br>
		<h2>It's fun</h2>

		<div class=3D"window">
			<div class=3D"window-header">
				<div class=3D"action-buttons"></div>
			</div>
			<pre><span></span><span class=3D"kn">from</span> <span class=3D"nn">tele=
gram</span> <span class=3D"kn">import</span> <span class=3D"n">Update</span=
>
<span class=3D"kn">from</span> <span class=3D"nn">telegram.ext</span> <span=
 class=3D"kn">import</span> <span class=3D"n">ApplicationBuilder</span><spa=
n class=3D"p">,</span> <span class=3D"n">CommandHandler</span><span class=
=3D"p">,</span> <span class=3D"n">ContextTypes</span>


<span class=3D"k">async</span> <span class=3D"k">def</span> <span class=3D"=
nf">hello</span><span class=3D"p">(</span><span class=3D"n">update</span><s=
pan class=3D"p">:</span> <span class=3D"n">Update</span><span class=3D"p">,=
</span> <span class=3D"n">context</span><span class=3D"p">:</span> <span cl=
ass=3D"n">ContextTypes</span><span class=3D"o">.</span><span class=3D"n">DE=
FAULT_TYPE</span><span class=3D"p">)</span> <span class=3D"o">-&gt;</span> =
<span class=3D"kc">None</span><span class=3D"p">:</span>
    <span class=3D"k">await</span> <span class=3D"n">update</span><span cla=
ss=3D"o">.</span><span class=3D"n">message</span><span class=3D"o">.</span>=
<span class=3D"n">reply_text</span><span class=3D"p">(</span><span class=3D=
"sa">f</span><span class=3D"s1">'Hello </span><span class=3D"si">{</span><s=
pan class=3D"n">update</span><span class=3D"o">.</span><span class=3D"n">ef=
fective_user</span><span class=3D"o">.</span><span class=3D"n">first_name</=
span><span class=3D"si">}</span><span class=3D"s1">'</span><span class=3D"p=
">)</span>


<span class=3D"n">app</span> <span class=3D"o">=3D</span> <span class=3D"n"=
>ApplicationBuilder</span><span class=3D"p">()</span><span class=3D"o">.</s=
pan><span class=3D"n">token</span><span class=3D"p">(</span><span class=3D"=
s2">"YOUR TOKEN HERE"</span><span class=3D"p">)</span><span class=3D"o">.</=
span><span class=3D"n">build</span><span class=3D"p">()</span>

<span class=3D"n">app</span><span class=3D"o">.</span><span class=3D"n">add=
_handler</span><span class=3D"p">(</span><span class=3D"n">CommandHandler</=
span><span class=3D"p">(</span><span class=3D"s2">"hello"</span><span class=
=3D"p">,</span> <span class=3D"n">hello</span><span class=3D"p">))</span>

<span class=3D"n">app</span><span class=3D"o">.</span><span class=3D"n">run=
_polling</span><span class=3D"p">()</span>
</pre>
