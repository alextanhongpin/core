evaltest.T[github.com/alextanhongpin/core/sync/throttle.ThrottleInput,github.com/alextanhongpin/core/sync/throttle.ThrottleOutput]{
  Name: "limit_zero_invalid",
  Input: throttle.ThrottleInput{
    Limit: 0,
    BacklogLimit: 0,
    BacklogTimeoutMs: 1000,
    Calls: 1,
  },
  Output: throttle.ThrottleOutput{
    LastErr: "",
  },
  Error: &errors.errorString{},
  ErrorString: "throttle: limit must be greater than 0",
  Logs: []interface {}{},
}
